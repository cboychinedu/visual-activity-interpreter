# Enable completion
autoload -Uz compinit
compinit

# ===== Ubuntu-style prompt =====
# Format: username@hostname:~/directory$
# PROMPT='%F{yellow}%f%F{green}%n@%m%f:%F{blue}%~%f$ '
PROMPT='%F{green}%n@%m%f:%F{blue}~%f$ '

# ===== Linux color support =====
export LS_COLORS='di=34:ln=36:so=35:pi=33:ex=32:bd=34;46:cd=34;43:su=30;41:sg=30;46:tw=30;42:ow=34;42'

# Enable colored ls
alias ls='ls --color=auto'
alias ll='ls -alF'
alias l='ls -CF'
alias clear='clear'

# ===== History settings =====
HISTSIZE=1000
SAVEHIST=1000
HISTFILE=~/.zsh_history

# ===== NVM (Node Version Manager) =====
export NVM_DIR="$HOME/.nvm"
[ -s "$NVM_DIR/nvm.sh" ] && \. "$NVM_DIR/nvm.sh"
[ -s "$NVM_DIR/bash_completion" ] && \. "$NVM_DIR/bash_completion"

# ===== Conda (leave as generated) =====
